    },
    "m_Slots": [
        {
            "m_Id": "af4398bbcc7c4c978e1985000eadc539"
        },
        {
            "m_Id": "3a513156abc6401f9c17289af8a6b412"
        },
        {
            "m_Id": "57b9acc654da48b79f949b6f2fa3bd51"
        },
        {
            "m_Id": "f9c61a9937264241a7b0a44c7b270088"
        },
        {
            "m_Id": "c46bb3f2903940a3991a28945e6036c0"
        },
        {
            "m_Id": "fb514bcebfcd451fb810c8fadd53ecb2"
        },
        {
            "m_Id": "3693bcdf747c427981f5428bcd6546f0"
        },
        {
            "m_Id": "36f363d73e944d4291ecd460ead21731"
        },
        {
            "m_Id": "97a8b426e9324a4b871d9638a7fc8ccf"
        },
        {
            "m_Id": "6948d70ee08d4810863e68044708adb3"
        },
        {
            "m_Id": "020cd1f139da4dbda69d8e7038857d76"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BlendMetallic",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float WeightSum0 = dot( Control0, float4( 1, 1, 1, 1 ) );\nfloat WeightSum1 = dot( Control1, float4( 1, 1, 1, 1 ) );\n\nfloat WeightTotal = WeightSum0 + WeightSum1;// + WeightSum2 +WeightSum3;\r\nControl0 /= ( WeightTotal + 1e-3f );\nControl1 /= ( WeightTotal + 1e-3f );\n\nfloat4 SplattedTexels0 = Texel0 * Control0.r + Texel1 * Control0.g + Texel2 * Control0.b + Texel3 * Control0.a;\nfloat4 SplattedTexels1 = Texel4 * Control1.r + Texel5 * Control1.g + Texel6 * Control1.b + Texel7 * Control1.a;\nOut = SplattedTexels0 + SplattedTexels1;"
}

